# Visual Studio
.vs/
*.user
*.suo
*.cache

# Rider / JetBrains
.idea/
*.iml

# VS Code
.vscode/
*.code-workspace

# AI assistant config
.devin/
.claude/
CLAUDE.md
AGENTS.md
.windsurf/
CONTRIBUTING.md

# OS files
Thumbs.db
.DS_Store
$RECYCLE.BIN/
.AppleDouble
.LSOverride
desktop.ini

# Temporary / backup files
*.tmp
*.temp
*.bak
*.backup
*.log
*~
.#*
*.lnk
